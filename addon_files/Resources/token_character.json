{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/token.json",
  "name": "token",
  "prefix": "token",
  "size": 1,
  "object": {
    "type": "image",
    "version": "5.3.0",
    "originX": "left",
    "originY": "top",
    "fill": "rgb(0,0,0)",
    "stroke": null,
    "strokeWidth": 0,
    "strokeDashArray": null,
    "strokeLineCap": "butt",
    "strokeDashOffset": 0,
    "strokeLineJoin": "miter",
    "strokeUniform": false,
    "strokeMiterLimit": 4,
    "angle": 0,
    "opacity": 1,
    "visible": true,
    "fillRule": "nonzero",
    "paintFirst": "fill",
    "globalCompositeOperation": "source-over",
    "crossOrigin": null,
    "filters": [],
    "clipShape": "circle"
  },
  "additions": [
    {
      "name": "hp_bar_bg",
      "type": "rect",
      "left": 0,
      "top": 0,
      "width": 100,
      "height": 8,
      "originX": "center",
      "originY": "top",
      "fill": "rgba(20,20,20,0.75)",
      "stroke": "rgba(0,0,0,0.5)",
      "strokeWidth": 1,
      "rx": 3,
      "ry": 3,
      "scaleX": 1,
      "scaleY": 1,
      "angle": 0,
      "opacity": 1,
      "visible": true,
      "tokenData": {
        "anchor": "bottom",
        "offsetX": 0,
        "offsetY": 4
      }
    },
    {
      "name": "hp_bar_fill",
      "type": "rect",
      "left": 0,
      "top": 0,
      "width": 100,
      "height": 8,
      "originX": "center",
      "originY": "top",
      "fill": "rgba(50,200,50,0.9)",
      "stroke": null,
      "strokeWidth": 0,
      "rx": 3,
      "ry": 3,
      "scaleX": 1,
      "scaleY": 1,
      "angle": 0,
      "opacity": 1,
      "visible": true,
      "tokenData": {
        "anchor": "bottom",
        "offsetX": 0,
        "offsetY": 4,
        "propDeps": [
          {
            "expression": "FromTo(%hp%, 0, %maxhp%, 0, 100)",
            "objectProperty": "width",
            "type": "number",
            "source": "card"
          },
          {
            "expression": "FromToEnum(%hp%, 0, %maxhp%, 0, 100, rgba(200,50,50,0.9), [{\"min\":0,\"max\":25,\"enumValue\":\"rgba(200,50,50,0.9)\"},{\"min\":25,\"max\":50,\"enumValue\":\"rgba(200,160,50,0.9)\"},{\"min\":50,\"max\":9999,\"enumValue\":\"rgba(50,200,50,0.9)\"}])",
            "objectProperty": "fill",
            "type": "string",
            "source": "card"
          }
        ]
      }
    },
    {
      "name": "name_label",
      "type": "text",
      "left": 0,
      "top": 0,
      "width": 100,
      "height": 12,
      "originX": "center",
      "originY": "top",
      "text": "",
      "fontSize": 11,
      "fontFamily": "Arial",
      "fontWeight": "bold",
      "fill": "rgba(255,255,255,0.95)",
      "stroke": "rgba(0,0,0,0.8)",
      "strokeWidth": 0.5,
      "textAlign": "center",
      "scaleX": 1,
      "scaleY": 1,
      "angle": 0,
      "opacity": 1,
      "visible": true,
      "tokenData": {
        "anchor": "bottom",
        "offsetX": 0,
        "offsetY": 16,
        "propDeps": [
          {
            "dtoProperty": "character_name",
            "objectProperty": "text",
            "type": "string",
            "source": "card"
          }
        ]
      }
    },
    {
      "name": "open_card_btn",
      "type": "reactIcon",
      "iconPack": "gi",
      "iconName": "GiNotebook",
      "left": 0,
      "top": 0,
      "width": 20,
      "height": 20,
      "originX": "center",
      "originY": "bottom",
      "fill": "rgba(255,255,255,0.95)",
      "scaleX": 1,
      "scaleY": 1,
      "angle": 0,
      "cursor": "pointer",
      "opacity": 1,
      "visible": false,
      "tokenData": {
        "anchor": "top",
        "offsetX": 0,
        "offsetY": -4,
        "showOnTokenControl": true,
        "actions": {
          "onClick": {
            "ClientMediatorAction": {
              "panel": "Game",
              "command": "CreateNewPanel",
              "data": { "type": "CardPanel", "props": { "id": "{{cardId}}" } }
            }
          }
        }
      }
    }
  ]
}
